@using Microsoft.AspNetCore
@using Microsoft.EntityFrameworkCore
@using YouToDo.Models
@using static YouToDo.Controllers.TaskController

@model TaskModel

@{
    ViewData["Title"] = "View Task";
}

<h1>@Model.Title</h1>

<div style="display: flex;">
    <div style="flex: 1; padding-right: 20px;">
        <div style="margin-top: 20px;">
            <p>
                <h2>@Model.Description</h2>                
            </p>
        </div>
    </div>

    <div style="flex: 1;">
        <div>
            <label>Приоритет</label>
            <p>
                @{
                    string priorityText = Model.Priority switch

                    {
                        YouToDo.Filters.PriorityLevel.High => "Высокий",
                        YouToDo.Filters.PriorityLevel.Medium => "Средний",
                        YouToDo.Filters.PriorityLevel.Low => "Низкий",
                        YouToDo.Filters.PriorityLevel.None => "Нет"
                    };
                    @priorityText
                }

            </p>
        </div>

        <div style="margin-top: 20px;">
            <label>Проект</label>
            <p>@Model.ProjectId</p>
        </div>

        <div style="margin-top: 20px;">
            <label>Теги</label>
            <p>@Model.Tags</p>
        </div>

        <div style="margin-top: 20px;">
            <label>Дата завершения</label>
            <p>@Model.DueDate?.ToString()</p>
        </div>
    </div>
</div>

<div style="margin-top: 20px; text-align: left;">
    <button onclick="location.href='@Url.Action("Edit", new { id = Model.Id })'" style="padding: 10px 20px;">Редактировать</button>
    <form asp-action="DeleteTask" method="post" style="display:inline;">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to delete this task?');">Удалить</button>
    </form>
</div>
