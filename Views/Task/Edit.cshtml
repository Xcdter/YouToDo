@using Microsoft.AspNetCore
@using Microsoft.EntityFrameworkCore
@using YouToDo.Models
@using static YouToDo.Controllers.TaskController

@model TaskModel

@{
    ViewData["Title"] = "Edit";
}

<h2>Создание / Редактировние задачи</h2>

<form asp-action="SaveTask" method="post">
    <input type="hidden" asp-for="Id" />
    <div style="display: flex;">
        <div style="flex: 1; padding-right: 20px;">
            <div>
                <label for="Title">Заголовок</label>
                <input type="text" id="Title" name="Title" style="width: 100%;" class="form-control" required />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div style="margin-top: 20px;">
                <label for="Description">Описание</label>
                <textarea id="Description" name="Description" style="width: 100%; height: 150px;"></textarea>
            </div>
        </div>

        <div style="flex: 1;">
            <div>
                <label for="Priority">Приоритет</label>
                <select id="Priority" name="Priority" style="width: 100%;">
                    <option value="0">Нет</option>
                    <option value="1">Низкий</option>
                    <option value="2">Средний</option>
                    <option value="3">Высокий</option>
                </select>
            </div>

            <div style="margin-top: 20px;">
                <label for="Project">Проект</label>
                <input type="text" id="Project" name="Project" style="width: 100%;" />
            </div>

            <div style="margin-top: 20px;">
                <label for="Tags">Теги</label>
                <input type="text" id="Tags" name="Tags" style="width: 100%;" />
            </div>

            <div style="margin-top: 20px;">
                <label for="Due">Дата завершения</label>
                <input type="date" id="Due" name="DueDate" style="width: 100%;" />
            </div>
        </div>
    </div>

    <div style="margin-top: 20px; text-align: left;">
        <button type="submit" style="padding: 10px 20px;">Сохранить</button>
        <a asp-action="List" class="btn btn-secondary">Отмена</a>
    </div>
</form>

