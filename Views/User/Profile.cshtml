@model User

@{
    ViewData["Title"] = "Profile Page";
}

<div style="display: flex; flex-direction: column; align-items: flex-start; font-family: Arial, sans-serif; padding: 20px;">
    <!-- Информация о пользователе -->
    <div style="margin-bottom: 20px;">
        <label style="font-size: 24px; font-weight: bold;">Имя:</label>
        <span style="font-size: 24px; margin-left: 10px; color: #333;">@Model.Name</span>
    </div>

    <div style="margin-bottom: 20px;">
        <label style="font-size: 24px; font-weight: bold;">E-mail:</label>
        <span style="font-size: 24px; margin-left: 10px; color: #333;">@Model.Email</span>
    </div>

    <!-- Кнопки управления -->
    <div style="margin-top: 20px; display: flex; gap: 10px;">
        <!-- Кнопка Редактировать -->
        <a asp-action="EditProfile" class="btn btn-primary" style="padding: 10px 20px; text-decoration: none;">
            Редактировать
        </a>

        <!-- Кнопка Назад -->
        <a asp-action="List" asp-controller="ListPage" class="btn btn-secondary" style="padding: 10px 20px; text-decoration: none;">
            Назад
        </a>

        <!-- Кнопка Выйти -->
        <form method="post" asp-action="Logout" style="display: inline;">
            <button type="submit" style="padding: 10px 20px; background-color: #dc3545; border: none; color: white; cursor: pointer;">
                Выйти
            </button>
        </form>
    </div>
</div>




