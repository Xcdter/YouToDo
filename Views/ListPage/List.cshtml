@model YouToDo.Models.TaskProjectModel

@{
    ViewData["Title"] = "Your Tasks";
}

<div class="container" style="display: flex;">
    <!-- Sidebar Section -->
    <aside style="width: 20%; padding: 20px; border-right: 1px solid #ddd;">
        <a asp-action="CreateTask" asp-controller="Task" class="create-btn btn btn-outline-dark" style="margin-bottom: 20px; display: block;">Создать задачу</a>
        <a asp-action="CreateProject" asp-controller="Project" class="create-btn btn btn-outline-dark" style="margin-bottom: 20px; display: block;">Создать проект</a>

        <ul class="project-list" style="list-style-type: none; padding: 0;">
            <!-- Кнопка "Все задачи" -->
            <li>
                <a href="@Url.Action("List", "ListPage")"
                   class="@(ViewBag.ActiveProjectId == null ? "active disabled" : "")"
                   style="text-decoration: none; font-weight: bold; color: @(ViewBag.ActiveProjectId == null ? "purple" : "#6c757d"); display: block; padding: 10px 0;"
                @(ViewBag.ActiveProjectId == null ? "tabindex='-1'" : "")>
                    Все задачи
                </a>
            </li>

            <!-- Список проектов -->
            @foreach (var project in Model.Projects)
            {
                <li>
                    @if (ViewBag.ActiveProjectId == project.Id)
                    {
                        <!-- Некликабельная активная ссылка -->
                        <span style="text-decoration: none; font-weight: bold; color: purple; display: block; padding: 10px 0;">
                            @project.Title
                        </span>
                    }
                    else
                    {
                        <!-- Кликабельная ссылка -->
                        <a asp-action="ViewProject" asp-controller="ListPage" asp-route-id="@project.Id"
                           style="text-decoration: none; color: #6c757d; display: block; padding: 10px 0;">
                            @project.Title
                        </a>
                    }
                </li>
            }
        </ul>
    </aside>

    <!-- Main Content Section -->
    <main style="width: 80%; padding: 20px;">
        <h1 style="font-size: 2em; color: #666;">
            Все задачи
            @if (!string.IsNullOrEmpty(Model.FilteredPriority))
            {
                <span>- @Model.FilteredPriority</span>
            }
        </h1>

        <table class="table task-table" style="width: 100%;">
            <thead>
                <tr>
                    <th style="background-color: #add8e6; color: #fff; text-align: left;">Заголовок</th>
                    <th style="background-color: #add8e6; color: #fff; text-align: left;">Приоритет</th>
                    <th style="background-color: #add8e6; color: #fff; text-align: left;">Проект</th>
                    <th style="background-color: #add8e6; color: #fff; text-align: left;">Теги</th>
                    <th style="background-color: #add8e6; color: #fff; text-align: left;">Дата завершения</th>
                    <th style="background-color: #add8e6; color: #fff; text-align: left;">Дата обновления</th>
                    <th style="background-color: #add8e6; color: #fff; text-align: left;">Дата создания</th>
                    <th style="background-color: #add8e6; color: #fff; text-align: left;">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in Model.Tasks)
                {
                    <tr>
                        <td><a asp-action="ViewTask" asp-controller="Task" asp-route-id="@task.Id" style="color: #007bff; text-decoration: none;">@task.Title</a></td>
                        <td>
                            <a asp-action="FilterByPriority"
                               asp-controller="ListPage"
                               asp-route-priority="@((short)task.Priority)"
                               style="color: #007bff; text-decoration: none;">
                                @task.Priority.ToString()
                            </a>
                        </td>
                        <td>@(task.Project != null ? task.Project.Title : "Без проекта")</td>
                        <td>@task.Tags</td>
                        <td>@task.DueDate?.ToString("yyyy-MM-dd")</td>
                        <td>@task.UpdatedDate?.ToString("yyyy-MM-dd")</td>
                        <td>@task.CreatedDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            <form asp-action="DeleteTask" asp-controller="Task" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@task.Id" />
                                <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Вы уверены, что хотите удалить задачу?');">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pagination -->
        <nav class="pagination" style="display: flex; justify-content: center; margin-top: 20px;">
            <ul style="list-style-type: none; padding: 0; display: flex; gap: 10px;">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li>
                        <a href="@Url.Action("List", "ListPage", new { page = i })"
                           style="color: @(ViewBag.CurrentPage == i ? "#007bff" : "#6c757d"); text-decoration: none;">
                            @i
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </main>
</div>
