@model YouToDo.Models.TaskProjectModel

@{
    ViewData["Title"] = "Your Tasks";
}

<div class="container" style="display: flex;">
    <!-- Sidebar Section -->
    <aside style="width: 20%; padding: 20px; border-right: 1px solid #ddd;">
        <a asp-action="CreateTask" asp-controller="Task" class="create-btn btn btn-outline-dark" style="margin-bottom: 20px; display: block;">Создать задачу</a>
        <a asp-action="CreateProject" asp-controller="Project" class="create-btn btn btn-outline-dark" style="margin-bottom: 20px; display: block;">Создать проект</a>

        <ul class="project-list" style="list-style-type: none; padding: 0;">
            <!-- Кнопка "Все задачи" -->
            <li>
                @if (Model.ActiveProjectId == null)
                {
                    <!-- Некликабельная активная ссылка -->
                    <span style="text-decoration: none; color: gray; display: block; padding: 10px 0;">
                        Все задачи
                    </span>
                }
                else
                {
                    <!-- Кликабельная ссылка -->
                    <a href="@Model.GenerateUrl(Url, "List", "ListPage", new { projectId = (int?)null, priority = (short?)null, tag = (string)null }, resetFilters: true)"
                       style="text-decoration: none; color: blue; display: block; padding: 10px 0;">
                        Все задачи
                    </a>
                }
            </li>

            <!-- Список проектов -->
            @foreach (var project in Model.Projects)
            {
                <li>
                    @if (Model.ActiveProjectId == project.Id)
                    {
                        <!-- Некликабельная активная ссылка -->
                        <span style="text-decoration: none; color: gray; display: block; padding: 10px 0;">
                            @project.Title
                        </span>
                    }
                    else
                    {
                        <!-- Кликабельная ссылка -->
                        <a href="@Model.GenerateUrl(Url, "List", "ListPage", new { projectId = project.Id, page = 1 }, resetFilters: true)"
                           style="text-decoration: none; color: blue; display: block; padding: 10px 0;">
                            @project.Title
                        </a>
                    }
                </li>
            }
        </ul>
    </aside>

    <!-- Main Content Section -->
    <main style="width: 80%; padding: 20px;">
        <h1 style="font-size: 2em; color: #666;">
            Все задачи
            @if (Model.FilteredPriority != null)
            {
                <span>- @Model.FilteredPriority.ToString()</span>
            }
            @if (!string.IsNullOrEmpty(Model.ActiveTag))
            {
                <span>- @Model.ActiveTag</span>
            }
        </h1>

        <!-- Кнопка сброса фильтров -->
        <div style="margin-bottom: 20px;">
            <button onclick="window.location.href='@Model.GenerateUrl(Url, "List", "ListPage", new { page = 1 }, resetFilters: true)'"
                    class="btn btn-outline-primary"
            @if (Model.FilteredPriority == null && Model.ActiveTag == null)
            {
                @:disabled
            }>
                Сброс фильтров
            </button>
        </div>

        <table class="table task-table" style="width: 100%; margin-top: 20px;">
            <thead>
                <tr>
                    <th style="background-color: #add8e6; color: #fff; text-align: left;">Заголовок</th>
                    <th style="background-color: #add8e6; color: #fff; text-align: left;">Приоритет</th>
                    <th style="background-color: #add8e6; color: #fff; text-align: left;">Проект</th>
                    <th style="background-color: #add8e6; color: #fff; text-align: left;">Теги</th>
                    <th style="background-color: #add8e6; color: #fff; text-align: left;">Дата завершения</th>
                    <th style="background-color: #add8e6; color: #fff; text-align: left;">Дата обновления</th>
                    <th style="background-color: #add8e6; color: #fff; text-align: left;">Дата создания</th>
                    <th style="background-color: #add8e6; color: #fff; text-align: left;">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in Model.Tasks)
                {
                    <tr>
                        <td><a asp-action="ViewTask" asp-controller="Task" asp-route-id="@task.Id" style="color: #007bff; text-decoration: none;">@task.Title</a></td>
                        <td>
                            <a href="@Model.GenerateUrl(Url, "List", "ListPage", new { priority = (short)task.Priority, page = 1 })"
                               style="color: #007bff; text-decoration: none;">
                                @task.Priority.ToString()
                            </a>
                        </td>
                        <td>@(task.Project != null ? task.Project.Title : "Без проекта")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(task.Tags))
                            {
                                foreach (var tag in task.Tags.Split(','))
                                {
                                    <a href="@Model.GenerateUrl(Url, "List", "ListPage", new { tag = tag.Trim(), page = 1 })"
                                       style="margin-right: 10px; text-decoration: none; color: #007bff;">
                                        @tag.Trim()
                                    </a>
                                }
                            }
                        </td>
                        <td>@task.DueDate?.ToString("yyyy-MM-dd")</td>
                        <td>@task.UpdatedDate?.ToString("yyyy-MM-dd")</td>
                        <td>@task.CreatedDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            <form asp-action="DeleteTask" asp-controller="Task" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@task.Id" />
                                <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Вы уверены, что хотите удалить задачу?');">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.TotalPages > 1)
        {
            <nav style="text-align: center; margin-top: 20px;">
                <ul style="list-style-type: none; padding: 0; display: inline-block;">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.CurrentPage)
                        {
                            <li style="display: inline-block; margin-right: 5px;">
                                <span style="color: gray; text-decoration: none; ">@i</span>
                            </li>
                        }
                        else
                        {
                            <li style="display: inline-block; margin-right: 5px;">
                                <a href="@Model.GenerateUrl(Url, "List", "ListPage", new { page = i })"
                                   style="color: blue; text-decoration: none;">@i</a>
                            </li>
                        }
                    }
                </ul>
            </nav>
        }
    </main>
</div>
